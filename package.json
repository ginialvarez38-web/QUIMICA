{
  "name": "chemia",
  "version": "0.1.0",
  "private": true,
  "description": "CHEMIA — plataforma universitaria interactiva de quimica, ciencias fundamentales, laboratorio e investigacion",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "test": "tsc -p tsconfig.test.json && node --test \"build-test/test/**/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "serve": "node tools/serve.js",
    "dev": "npm run build && npm run serve"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {},
  "devDependencies": {}
}
